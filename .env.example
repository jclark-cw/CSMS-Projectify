# Copy to .env (git-ignored) and fill in. Never commit the real .env.
#   chmod 600 .env

# ── Asana (Phase 2) ─────────────────────────────────────────────────────────
# Personal Access Token for a DEDICATED service account scoped to the target
# team only — not a personal admin token.
ASANA_PAT=
# Workspace and team the new projects should be created under.
ASANA_WORKSPACE_GID=
ASANA_TEAM_GID=

# ── DocuSign (auto-trigger — JWT grant; needs requirements-docusign.txt) ────
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_USER_ID=
# Path to the JWT private key file (keep outside the repo; chmod 600).
DOCUSIGN_PRIVATE_KEY_PATH=
# Optional. Defaults to production; for the DocuSign sandbox use the demo hosts:
#   DOCUSIGN_BASE_URI=https://demo.docusign.net/restapi
#   DOCUSIGN_OAUTH_HOST=account-d.docusign.com
DOCUSIGN_BASE_URI=
DOCUSIGN_OAUTH_HOST=
# Optional: only process envelopes in this folder (the sponsorship folder gid).
DOCUSIGN_FOLDER_ID=
