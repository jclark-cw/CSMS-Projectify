# Copy to .env (git-ignored) and fill in. Never commit the real .env.
#   chmod 600 .env

# ── Asana (Phase 2) ─────────────────────────────────────────────────────────
# Personal Access Token for a DEDICATED service account scoped to the target
# team only — not a personal admin token.
ASANA_PAT=
# Workspace and team the new projects should be created under.
ASANA_WORKSPACE_GID=
ASANA_TEAM_GID=

