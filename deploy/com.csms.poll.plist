<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd template for the scheduled DocuSign poll (macOS). Runs the SAME
     `csms poll` command the manual button uses, every StartInterval seconds.
     Edit the paths, then install (see deploy/README.md). Linux: use cron;
     Windows: Task Scheduler. No public endpoint — outbound polling only. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.csms.poll</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-m</string>
    <string>csms</string>
    <string>poll</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/josephclark/Projects/CSMS</string>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/josephclark/Projects/CSMS/state/poll.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/josephclark/Projects/CSMS/state/poll.err.log</string>
</dict>
</plist>
